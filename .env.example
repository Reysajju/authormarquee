# Copy to .env.local for local dev. PLACEHOLDERS ONLY — never commit real keys.
# Supabase (required only when you move off mock data)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-placeholder-do-not-expose

# Stripe / DodoPay (web checkout only, email upsells)
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
DODOPAY_API_KEY=dodopay_placeholder

# Firebase Cloud Messaging (Android push, via Capacitor push-notifications)
NEXT_PUBLIC_FCM_SENDER_ID=fcm-sender-id-placeholder
FCM_SERVER_KEY=fcm-server-key-placeholder

# RevenueCat (Google Play Billing wrapper, in-app only)
NEXT_PUBLIC_REVENUECAT_ANDROID_KEY=revenuecat-android-placeholder

# App / site
# Local dev URL. Planned production site (NOT live — domain not yet bought/confirmed):
# https://authormarquee.com  (claim: /claim/<slug>, delete-account: /delete-account)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=AuthorMarquee
